# Define variables
define LAN_SUBNET_V4 = { 192.168.0.0/24, 192.168.31.0/24, 10.0.178.0/24 }
define LAN_SUBNET_V6 = fe80::/64

# Create a table for filtering
table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;

    # Allow loopback & essential ICMP (ping, MTU, ND)
    iif "lo" accept

    # Allow established/related connections
    ct state { established, related } accept

    # Allow ICMP errors/ping and all IPv6 Neighbor Discovery messages:
    #   133 RS / 134 RA / 135 NS / 136 NA.
    # RA arrives via multicast (src fe80::/10, dst ff02::1); without
    # this rule the host never gets a global IPv6 address (SLAAC).
    icmp type { echo-request, destination-unreachable, time-exceeded } accept
    icmpv6 type { echo-request, destination-unreachable, time-exceeded,
                  nd-router-solicit, nd-router-advert,
                  nd-neighbor-solicit, nd-neighbor-advert } accept

    # IPv6 multicast listener discovery (130/131/132/143): required for
    # the host to receive any link-local multicast (e.g. ff02::fb for
    # mDNS). Payload itself is filtered by the port rules below.
    ip6 daddr ff02::/16 icmpv6 type { mld-listener-query, mld-listener-report,
                                      mld-listener-done, mld2-listener-report } accept

    # Allow port 7890 from LAN (IPv4 & IPv6)
    ip saddr $LAN_SUBNET_V4 tcp dport 7890 accept
    ip saddr $LAN_SUBNET_V4 tcp dport 25565 accept
    ip6 saddr $LAN_SUBNET_V6 tcp dport 7890 accept
    ip6 saddr $LAN_SUBNET_V6 tcp dport 25565 accept

    # Allow weed master/volume ports from LAN
    ip saddr $LAN_SUBNET_V4 tcp dport { 9333, 19333 } accept
    ip6 saddr $LAN_SUBNET_V6 tcp dport { 9333, 19333 } accept

    # TODO(jinser): modular
    # mDNS (avahi discovery/publishing), LAN-only like the rules above.
    # mDNS ships over link-local, hence fe80::/10 instead of $LAN_SUBNET_V6.
    ip saddr $LAN_SUBNET_V4 udp dport 5353 accept # MDNS
    ip6 saddr fe80::/10 udp dport 5353 accept # MDNS
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
